VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-project-key
# URL pública do microsserviço FastAPI de acessibilidade (não coloque a chave Gemini aqui).
# VITE_AI_SERVICE_URL=http://localhost:8000
# Optional OAuth providers, comma-separated. Each provider must also be enabled in Supabase.
# VITE_SUPABASE_AUTH_PROVIDERS=google,apple,azure
VITE_API_BASE_URL=http://localhost:5000
# Legacy fallback only; prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional JSON endpoints for municipal and state transparency portals.
# VITE_NATAL_TRANSPARENCIA_API_URL=https://your-api.example/natal/transparencia
# VITE_RN_TRANSPARENCIA_API_URL=https://your-api.example/rn/transparencia
